# Database (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/parkpilot?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/parkpilot?schema=public"

# Application
NODE_ENV="development"
PORT="3001"
APP_URL="http://localhost:5173"
API_URL="http://localhost:3001"

# Authentication (generate a strong 32+ char random secret for production)
JWT_SECRET="replace-with-strong-random-secret-at-least-32-chars"
SESSION_COOKIE_NAME="parkpilot_session"

# Initial Admin Seed Account (never commit real production credentials)
ADMIN_EMAIL="admin@parkpilot.local"
ADMIN_PASSWORD="ChangeMeAdmin123!"
ADMIN_NAME="ParkPilot Admin"

# Stripe Payments (leave empty for clearly labelled local dev test mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Resend Transactional Email (leave empty to log email previews in local dev)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ParkPilot <bookings@parkpilot.example>"

# Booking & Cancellation Policy Configuration
HOLD_DURATION_MINUTES="15"
FREE_CANCELLATION_HOURS_BEFORE="2"
PARTIAL_REFUND_PERCENT="50"

# Development payment simulation toggle (only active when NODE_ENV !== 'production' and Stripe is unconfigured)
ENABLE_DEV_PAYMENT_MODE="true"
